{
  "name": "@wsvaio/pinia-plugin-persist",
  "type": "module",
  "version": "1.0.5",
  "description": "pinia持久化插件，可兼容uniapp",
  "author": "wsvaio <wsvaio@qq.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/wsvaio",
  "homepage": "https://github.com/wsvaio/pinia-plugin-persist#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsvaio/pinia-plugin-persist.git"
  },
  "bugs": {
    "url": "https://github.com/wsvaio/pinia-plugin-persist/issues"
  },
  "keywords": [
    "wsvaio",
    "uniapp",
    "persist",
    "pinia",
    "pinia-plugin",
    "pinia-plugin-persist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "dev": "vite ./playground",
    "build": "tsdown --clean --dts",
    "prepublishOnly": "pnpm build",
    "lint:check": "oxlint",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint:lint-staged": "lint-staged",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "pinia": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "lint-staged": "^17.0.2",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@wsvaio/utils": "latest"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs"
}
